# dependencies — UNANCHORED, so they match at any depth. A leading slash would pin them to
# the repo root, and no dependency directory is ever created there.
vendor/
node_modules/

# THE LARAVEL APP'S RUNTIME PATHS ARE NOT LISTED HERE. They belong to `server/.gitignore`,
# which Laravel ships and maintains, plus the per-directory `.gitignore` files under
# `server/storage/` and `server/bootstrap/cache/`. This file used to restate them
# (`/public/build/`, `/storage/framework/*`, `/bootstrap/cache/*` …) with leading slashes,
# anchoring every one of them to the repo root — where, since the app lives in `server/`
# (docs/PLAN.md D-16), they could never match anything. A second copy of a rule that silently
# matches nothing is worse than no copy: it reads as coverage. Verified with
# `git check-ignore -v` against a planted file for each path.

# env + secrets — never commit. These are deliberately unanchored and DO reach `server/`.
.env
.env.*
!.env.example
*.pem
*-token
# …but `bin/promote-cards-by-token` is a SCRIPT whose name ends in "-token", not a credential.
# Without this line `git add -A` drops it silently and the release workflow ships without the
# tool it runs. Keep the `*-token` rule as-is — it is the one guarding real token FILES — and
# keep this exception as narrow as it is.
!bin/promote-cards-by-token
auth.json

# python bytecode (the selftests import the lint by path)
__pycache__/
*.pyc

# editor / os
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
