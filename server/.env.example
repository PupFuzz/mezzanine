# This file is the TEMPLATE and is the only one of the pair that is committed. Copy it to
# .env and fill it in on the host; .env is ignored by git and must stay that way. Nothing in
# this file may ever carry a real value — APP_KEY is left empty deliberately and is minted
# per host with `php artisan key:generate`.

APP_NAME=Mezzanine
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The store is MySQL on a dedicated host; docs/design/FLEET-STATE.md § 6.1 owns the version
# floor, the TLS posture and the session time zone, and § 6.2 owns the database names per
# environment (production and sandbox differ — do not copy one host's value to the other).
# Left on sqlite here because that is what a local checkout can run without provisioning;
# § 6.1's requirements bind the moment DB_CONNECTION becomes mysql.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=
# DB_PORT=3306
# DB_DATABASE=mezzanine
# DB_USERNAME=
# DB_PASSWORD=
# TLS is required and its certificate verified — § 6.1 states there is no plaintext fallback.
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# DB_URL and DB_SQLITE_DATABASE are both deliberate. A URL's path REPLACES the database name
# parsed out of DB_DATABASE (§ 6.2), so it stays empty unless something genuinely needs it.
# DB_SQLITE_DATABASE addresses the sqlite connection alone — see config/database.php.
DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ⚠ The `log` and `null` broadcasters implement auth() as an empty method, so channel
# authorization callbacks in routes/channels.php are NOT consulted under them. The live gate
# on the handshake is the middleware on /broadcasting/auth (bootstrap/app.php). Card #7339
# configures the real broadcaster; it must keep that middleware.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# 11 and 10 are claimed for Mezzanine in docs/design/FLEET-STATE.md § 6.2, against the
# numbers other seats on a shared box have published. Unpinned, these default to 0 and 1 —
# which is what every other unpinned seat also gets.
REDIS_DB=11
REDIS_CACHE_DB=10
REDIS_URL=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
