# This file is the TEMPLATE and is the only one of the pair that is committed. Copy it to
# .env and fill it in on the host; .env is ignored by git and must stay that way. Nothing in
# this file may ever carry a real value — APP_KEY is left empty deliberately and is minted
# per host with `php artisan key:generate`.

APP_NAME=Mezzanine
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The name authenticator apps show for this site's two-factor entry. Unset, it is the first label
# of APP_URL's host (https://sandboxmezzanine.neeba.com → "sandboxmezzanine"); set it only when a
# host wants something else. It labels NEW enrolments only — see README § The authenticator entry's
# name.
# TWO_FACTOR_ISSUER=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The store is MariaDB, and it is the ONLY supported engine — locally, in CI and on every host.
# SQLite is not a supported configuration (docs/PLAN.md D-15 and its amendments; card#9328).
# docs/design/FLEET-STATE.md § 6.1 owns the version floor, the TLS posture and the session time
# zone, and § 6.2 owns the database names per environment (production and sandbox differ — do not
# copy one host's value to the other). DB_CONNECTION is the LARAVEL CONNECTION NAME, not the
# server product: the app reaches its MariaDB store through `mysql`, and bin/deploy.sh refuses
# anything else.
# The values below are PLACEHOLDERS for a local development server, matching the database and
# account README.md § Running the server locally creates; DB_PASSWORD is left empty on purpose and
# is set per checkout. A deployed host fills in its own values for every key.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mezzanine
DB_USERNAME=mezzanine
DB_PASSWORD=
# Required for a store on ANOTHER host: TLS with its certificate verified, and § 6.1 states there is
# no plaintext fallback. Not needed for a store on the same host — DB_SOCKET naming the socket's path,
# or DB_HOST localhost, 127.0.0.1 or ::1 — where no network is crossed (D-15's 2026-09-14 amendment); bin/deploy.sh refuses
# only the first case without it. Leave it unset for a same-host store that serves no TLS: with it set,
# pdo_mysql requires TLS over the socket too, and every connection fails.
# "Unset" here means the line left out or left empty — NOT `MYSQL_ATTR_SSL_CA=null`, the idiom other
# keys in this file use: Laravel reads that literal as a falsy value, config/database.php's array_filter
# drops the option, and the connection carries no TLS at all. bin/deploy.sh A5 counts it unset for that
# reason, and refuses it for a store on another host.
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# DB_URL is deliberate: a URL's path REPLACES the database name parsed out of DB_DATABASE
# (§ 6.2), so it stays empty unless something genuinely needs it.
DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Unset, the session cookie is Secure whenever APP_ENV is production, and outside production it is
# Secure only on a request PHP sees as HTTPS (server/config/session.php; docs/PLAN.md § 5). Set it
# to true or false to override that default either way.
# SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ⛔ MUST PERSIST BETWEEN REQUESTS. `array`/`null` reintroduces the login-path user-enumeration
# oracle that App\Auth\ActiveUserProvider's cached dummy hash closes — docs/PLAN.md § 5 owns the
# obligation and the measurement.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# 11 and 10 are claimed for Mezzanine in docs/design/FLEET-STATE.md § 6.2, against the
# numbers other seats on a shared box have published. Unpinned, these default to 0 and 1 —
# which is what every other unpinned seat also gets.
REDIS_DB=11
REDIS_CACHE_DB=10
REDIS_URL=

# ⛔ A HOST THAT WANTS THE TWO-FACTOR RESET MUST SET THIS TO A REAL TRANSPORT (card#9077).
# Under `log` the whole rendered message — reset code included — is written to storage/logs/, and
# under `array` nothing is delivered at all, so `App\Auth\TwoFactorReset::isAvailable()` REFUSES
# the reset on both and the request page says so. Prove a configured transport before it is needed:
#   php artisan mezzanine:mail:preflight --to=you@example.com
# Left on `log` here because that is what a local checkout can run without provisioning.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
