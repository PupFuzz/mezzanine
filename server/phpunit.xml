<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>

        <!--
            Store isolation, per docs/design/FLEET-STATE.md § 6.2, which owns these values.
            EVERY PIN BELOW IS TWO ADJACENT ENTRIES THAT MUST AGREE — an <env force="true">
            and a matching <server>. `force` writes putenv() and $_ENV but never $_SERVER,
            and Laravel's env() reads $_SERVER first, so the <env> half alone loses to an
            exported variable. DatabasePinTest asserts the pairing, because the mode this
            guards against is one line of a pair being edited.
        -->
        <env    name="DB_DATABASE"    value="mezzanine_test" force="true"/>
        <server name="DB_DATABASE"    value="mezzanine_test"/>
        <env    name="DB_URL"         value="" force="true"/>
        <server name="DB_URL"         value=""/>
        <env    name="REDIS_DB"       value="11" force="true"/>
        <server name="REDIS_DB"       value="11"/>
        <env    name="REDIS_CACHE_DB" value="10" force="true"/>
        <server name="REDIS_CACHE_DB" value="10"/>
        <env    name="REDIS_URL"      value="" force="true"/>
        <server name="REDIS_URL"      value=""/>

        <!--
            DB_CONNECTION IS `mysql`: MariaDB is the only engine this application runs on
            (docs/PLAN.md D-15; SQLite is not a supported configuration, card#9328). `mysql` is
            the LARAVEL CONNECTION NAME in config/database.php, not the server product — the
            connection bin/deploy.sh requires and the one every pin above is read through.

            DECLARED, AND DELIBERATELY STILL NOT FORCED — for a different reason than before.
            It used to be unforced so that a CI lane could export a DIFFERENT engine and win.
            With one engine nothing selects a backend any more, so that reason is gone. What
            replaces it: forcing it would SILENTLY turn an exported DB_CONNECTION=<anything
            else> into a green run on `mysql` — a run reporting something other than what its
            caller asked for, which is § 6.2 finding 4's shape (a matrix that "tested" an engine
            it never ran) pointed the other way. Unforced, the export wins, and
            Tests\TestCase's resolved-value guard then ABORTS the run by name because
            `database.default` is not `mysql`. A refusal is louder than a quiet substitution.

            This declaration, not .env, is what a checkout with nothing exported runs on — an
            unforced <env> beats .env (§ 6.2 finding 1). CI exports DB_CONNECTION=mysql, which
            beats it, so a flip of THIS value would be invisible to the resolved guard there;
            DatabasePinTest therefore asserts the declared value as well as the missing force.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
    </php>
</phpunit>
